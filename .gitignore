# ── Sanal ortamlar ───────────────────────────────────────────────
.venv/
.venv.*/
venv/
# NOT: 'env/' ve 'ENV/' KALDIRILDI — kaynak paketimiz env/ (PortfolioEnv) bu
# kalıplarla çakışıp izlenmiyordu. Sanal ortamlar zaten .venv/ kullanıyor.

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Coverage (üretilen — izlenmez) ───────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── Proje çıktıları (yeniden üretilebilir) ───────────────────────
results/
figures/
data/*.parquet
data/*.csv

# Golden-master regresyon referansları İZLENİR (gitignore edilmez):
!tests/golden/

# ── OS / editör ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
